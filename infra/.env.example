# Aurelinx Infrastructure Environment Configuration
# Copy to .env.local (development) or .env.production (production)
# NEVER commit files with real values to version control!

# =============================================================================
# DOCKER COMPOSE PROJECT
# =============================================================================
COMPOSE_PROJECT_NAME=aurelinx
COMPOSE_FILE=docker-compose.dev.yml:docker-compose.override.yml

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_USER=aurelinx
POSTGRES_PASSWORD=password
POSTGRES_DB=aurelinx
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./postgres_data

# PostgreSQL Performance (Development)
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# =============================================================================
# REDIS
# =============================================================================
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATA_PATH=./redis_data
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_DATA_PATH=./qdrant_data
QDRANT_STORAGE__STORAGE_PATH=./qdrant_data/storage
QDRANT_LOG_LEVEL=INFO

# =============================================================================
# BACKEND (FastAPI)
# =============================================================================
BACKEND_PORT=8000
BACKEND_WORKERS=2
BACKEND_LOG_LEVEL=INFO

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
FRONTEND_PORT=3001
FRONTEND_API_URL=http://backend:8000

# =============================================================================
# WORKERS
# =============================================================================
WORKER_CONCURRENCY=4
WORKER_LOG_LEVEL=INFO

# Screening Worker
SCREENING_WORKER_REPLICAS=2

# Sync Worker
SYNC_WORKER_REPLICAS=1

# Analytics Worker
ANALYTICS_WORKER_REPLICAS=1

# =============================================================================
# SCHEDULER (Celery Beat)
# =============================================================================
SCHEDULER_LOG_LEVEL=INFO

# =============================================================================
# MAILHOG (Email Testing - Development Only)
# =============================================================================
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# =============================================================================
# NGINX (Production Reverse Proxy)
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SSL_CERT_PATH=./certs/fullchain.pem
NGINX_SSL_KEY_PATH=./certs/privkey.pem
NGINX_CLIENT_MAX_BODY_SIZE=50M

# =============================================================================
# MONITORING (Optional)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093

# =============================================================================
# NETWORKING
# =============================================================================
NETWORK_NAME=aurelinx-network
NETWORK_DRIVER=bridge

# =============================================================================
# RESOURCE LIMITS (Docker Compose Deploy)
# =============================================================================
# Backend
BACKEND_CPUS=2
BACKEND_MEMORY=2G

# Frontend
FRONTEND_CPUS=1
FRONTEND_MEMORY=1G

# Workers
WORKER_CPUS=2
WORKER_MEMORY=2G

# Database
POSTGRES_CPUS=2
POSTGRES_MEMORY=4G

# Redis
REDIS_CPUS=1
REDIS_MEMORY=2G

# Qdrant
QDRANT_CPUS=2
QDRANT_MEMORY=4G