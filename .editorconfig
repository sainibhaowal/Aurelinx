# EditorConfig for Aurelinx
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mdx,txt,yml,yaml,json,toml,ini,cfg}]
indent_size = 2

[*.{py}]
indent_size = 4

[*.{js,jsx,ts,tsx,vue,svelte}]
indent_size = 2

[*.{rs}]
indent_size = 4

[*.{html,css,scss,less}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 2

[*.{dockerfile,Dockerfile}]
indent_size = 2

[*.{tf, tfvars}]
indent_size = 2