# Aurelinx Frontend Environment Configuration
# Copy to .env.local and fill in your values
# NEVER commit .env.local with real values to version control!

# =============================================================================
# API CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# APP METADATA
# =============================================================================
NEXT_PUBLIC_APP_NAME=Aurelinx
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_APP_DESCRIPTION=HR Intelligence Platform for Talent Operations

# =============================================================================
# FEATURE FLAGS
# =============================================================================
NEXT_PUBLIC_ENABLE_CHAT_AGENT=true
NEXT_PUBLIC_ENABLE_SENTIMENT=true
NEXT_PUBLIC_ENABLE_SCREENING=true
NEXT_PUBLIC_ENABLE_TEAM_OPTIMIZATION=true
NEXT_PUBLIC_ENABLE_CONNECTORS=true
NEXT_PUBLIC_ENABLE_DESKTOP_REDIRECT=true

# =============================================================================
# AUTHENTICATION
# =============================================================================
NEXT_PUBLIC_AUTH_PROVIDERS=credentials,google,microsoft
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

NEXT_PUBLIC_GA_ID=  # Google Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=  # Plausible Analytics

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================
NEXT_PUBLIC_DEFAULT_THEME=system  # light, dark, system
NEXT_PUBLIC_SIDEBAR_COLLAPSED=false
NEXT_PUBLIC_ANIMATIONS_ENABLED=true
NEXT_PUBLIC_DENSITY=comfortable  # compact, comfortable, spacious

# =============================================================================
# FILE UPLOAD
# =============================================================================
NEXT_PUBLIC_MAX_FILE_SIZE=52428800  # 50MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt,.md,.jpg,.jpeg,.png,.webp

# =============================================================================
# INTERNATIONALIZATION (Future)
# =============================================================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr,de

# =============================================================================
# DESKTOP APP (Tauri)
# =============================================================================
NEXT_PUBLIC_TAURI_APP_URL=https://aurelinx.yourdomain.com
NEXT_PUBLIC_TAURI_UPDATE_CHANNEL=stable