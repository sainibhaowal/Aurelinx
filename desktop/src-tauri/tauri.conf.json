{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurelinx",
  "version": "1.2.0",
  "identifier": "com.aurelinx.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3100"
  },
  "app": {
    "windows": [
      {
        "title": "Aurelinx",
        "url": "index.html",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ravinder Singh",
    "copyright": "Copyright 2026 Ravinder Singh. All rights reserved.",
    "category": "Business",
    "shortDescription": "Autonomous HR intelligence and workforce analytics management platform",
    "longDescription": "Aurelinx unifies live workforce analytics, AI agent governance, and automated risk parameters into a high-precision executive control panel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
