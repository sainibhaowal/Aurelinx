# Aurelinx Backend Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env with real values to version control!

# =============================================================================
# CORE APPLICATION
# =============================================================================
APP_NAME=Aurelinx
APP_VERSION=1.0.0-dev
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# =============================================================================
# DATABASE (PostgreSQL 15+)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://aurelinx:password@localhost:5432/aurelinx

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS (Cache + Celery Broker)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# QDRANT (Vector Search)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aurelinx

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate secret: openssl rand -base64 32
JWT_SECRET_KEY=your-32-byte-base64-secret-key-here
JWT_ALGORITHM=RS256

# RSA Keys (Production: use proper key management)
# Generate: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token Expiry
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REFRESH_TOKEN_ROTATION=true

# =============================================================================
# SECURITY
# =============================================================================
# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,tauri://localhost

# Trusted hosts for Host header validation
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Password Hashing (argon2id)
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=4

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/aurelinx.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aurelinx-backend

# =============================================================================
# EMAIL (Notifications)
# =============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=noreply@aurelinx.local
SMTP_FROM_NAME=Aurelinx
SMTP_ENABLED=false
SMTP_TIMEOUT_SECONDS=15
# Ten minutes gives email delivery and the user enough time to enter the OTP.
EMAIL_VERIFICATION_EXPIRE_SECONDS=600

# =============================================================================
# CONNECTORS (HR System Integrations)
# =============================================================================

# Greenhouse
GREENHOUSE_API_KEY=
GREENHOUSE_API_BASE_URL=https://harvest.greenhouse.io/v1
GREENHOUSE_WEBHOOK_SECRET=

# Workday
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_TENANT=
WORKDAY_BASE_URL=https://wd5-services.workday.com

# Lever (Planned)
LEVER_API_KEY=
LEVER_WEBHOOK_SECRET=

# BambooHR (Planned)
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=

# Generic Webhook Security
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_TOLERANCE_SECONDS=300

# =============================================================================
# LLM PROVIDERS (Chat Agent)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Google Vertex AI (Planned)
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
VERTEX_AI_MODEL=

# Local Models (Ollama, etc. - Planned)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# =============================================================================
# CELERY (Background Workers)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Worker Configuration
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true

# Queues
CELERY_TASK_ROUTES={
    "app.workers.tasks.screening.*": {"queue": "screening"},
    "app.workers.tasks.sync.*": {"queue": "sync"},
    "app.workers.tasks.analytics.*": {"queue": "analytics"},
    "app.workers.tasks.notifications.*": {"queue": "notifications"},
}

# Beat Schedule (Periodic Tasks)
CELERY_BEAT_SCHEDULE={
    "sync-greenhouse-candidates": {
        "task": "app.workers.tasks.sync.sync_greenhouse_candidates",
        "schedule": 3600,  # Every hour
    },
    "sync-workday-employees": {
        "task": "app.workers.tasks.sync.sync_workday_employees",
        "schedule": 86400,  # Daily
    },
    "compute-team-analytics": {
        "task": "app.workers.tasks.analytics.compute_team_analytics",
        "schedule": 3600,  # Hourly
    },
    "cleanup-expired-approvals": {
        "task": "app.workers.tasks.cleanup.cleanup_expired_approvals",
        "schedule": 300,  # Every 5 minutes
    },
}

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local (Development)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# S3 (Production - Uncomment and configure)
# STORAGE_BACKEND=s3
# S3_BUCKET=aurelinx-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=  # For MinIO/custom endpoints

# File Upload Limits
MAX_FILE_SIZE=52428800  # 50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,jpg,jpeg,png,webp

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_CHAT_AGENT=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_SCREENING_ENGINE=true
ENABLE_TEAM_OPTIMIZATION=true
ENABLE_CONNECTORS=true
ENABLE_WEBHOOKS=true
ENABLE_AUDIT_LOG=true
ENABLE_DATA_EXPORT=true

# =============================================================================
# DATA POLICY & COMPLIANCE
# =============================================================================
DATA_RETENTION_DAYS=2555  # 7 years
PII_ENCRYPTION_ENABLED=true
DATA_EXPORT_FORMATS=json,csv,xlsx,pdf
GDPR_COMPLIANCE_ENABLED=true
CCPA_COMPLIANCE_ENABLED=true

# =============================================================================
# MONITORING & METRICS
# =============================================================================
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DETAILED=true
